{
  "canonicalBase": "https://cht.example.org/api/v1/fhir",
  "patient": {
    "contactType": "person",
    "sourceFilter": null,
    "elements": {
      "Patient.name.text": { "kind": "doc", "path": "doc.name" },
      "Patient.gender": { "kind": "doc", "path": "doc.sex" },
      "Patient.birthDate": { "kind": "doc", "path": "doc.date_of_birth" },
      "Patient.deceasedDateTime": { "kind": "doc", "path": "doc.date_of_death" },
      "Patient.telecom.phone": { "kind": "doc", "path": "doc.phone" },
      "Patient.managingOrganization": { "kind": "doc", "path": "doc.parent._id" }
    },
    "identifiers": [
      {
        "system": "{base}/identifier/patient-id",
        "use": "official",
        "type": {
          "system": "http://terminology.hl7.org/CodeSystem/v2-0203",
          "code": "MR",
          "display": "Medical record number"
        },
        "source": { "kind": "doc", "path": "doc.patient_id" }
      }
    ]
  },
  "encounters": {
    "pregnancy": {
      "elements": {
        "Encounter.status": { "kind": "const", "value": "finished" },
        "Encounter.class": { "kind": "const", "value": "HH" },
        "Encounter.type": { "kind": "const", "value": "Pregnancy registration" },
        "Encounter.period.start": { "kind": "doc", "path": "doc.reported_date" },
        "Encounter.subject": { "kind": "doc", "path": "doc.fields.inputs.contact._id" },
        "Encounter.participant.individual": { "kind": "doc", "path": "doc.contact._id" }
      },
      "observations": [
        {
          "code": { "system": "http://loinc.org", "code": "11778-8", "display": "Delivery date Estimated" },
          "valueMode": "valueDateTime",
          "source": { "kind": "field", "path": "edd_8601" }
        },
        {
          "code": { "system": "http://loinc.org", "code": "8665-2", "display": "Last menstrual period start date" },
          "valueMode": "valueDateTime",
          "source": { "kind": "field", "path": "lmp_date_8601" }
        },
        {
          "code": {
            "system": "https://cht.example.org/api/v1/fhir/CodeSystem/cht-fields",
            "code": "weeks-since-lmp",
            "display": "Weeks since LMP"
          },
          "valueMode": "valueQuantity",
          "unit": { "system": "http://unitsofmeasure.org", "code": "wk", "display": "wk" },
          "source": { "kind": "field", "path": "weeks_since_lmp" }
        }
      ]
    }
  }
}
