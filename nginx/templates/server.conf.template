resolver 127.0.0.11 valid=10s; # 127.0.0.11 is from default /etc/resolv.conf
set $upstream_endpoint http://${API_HOST}:${API_PORT};

proxy_set_header        Host            $host;
proxy_set_header        X-Real-IP       $remote_addr;
proxy_set_header        X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header        X-Forwarded-Proto https;
proxy_set_header        X-Forwarded-Host $server_name;

location / {
  client_max_body_size    1G;
  if ($is_media_request = 0) {
    rewrite ^ /__cht_limited_request last;
  }
  proxy_pass              $upstream_endpoint;
}

# Non-media requests keep the default 32M limit
location = /__cht_limited_request {
  internal;
  proxy_pass              $upstream_endpoint$request_uri;
}
